# =============================================================================
# Milimo Music — Environment configuration template
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real API keys.
#
# Backend loads this via python-dotenv (see backend/app/services/config_manager.py).
# =============================================================================

# ── LLM provider API keys & endpoints ────────────────────────────────────────
# Set these to your own keys. Leave blank if you don't use that provider.
LLM_PROVIDER=nvidia

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=minimax-m3

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-3.5-turbo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Apple Silicon LLM server (OMLX)
OMLX_API_KEY=omlx
OMLX_BASE_URL=http://localhost:8787/v1
OMLX_MODEL=Llama-3.2-3B-Instruct-bf16

# Local Ollama server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-fp16

# LM Studio (OpenAI-compatible local)
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# ── Generation model paths ───────────────────────────────────────────────────
# Absolute path to the installed MiniMax Music 3 MLX snapshot
MINIMAX_MODEL_PATH=/Users/youruser/.cache/huggingface/hub/models--mlx-community--MiniMax-Music3-bf16/snapshots/<snapshot-id>

# Storage directories (relative to backend/)
MODEL_DIRECTORY=../heartlib/ckpt
CHECKPOINTS_DIRECTORY=./data/checkpoints
DATASETS_DIRECTORY=./data/datasets

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend (Vite — the VITE_ prefix is required and must be in a frontend/.env) ──
VITE_API_URL=http://localhost:8000

# ── Security & Operations (Phase 1) ─────────────────────────────────────────
# Bearer token for the API. UNSET = open localhost dev mode (default).
# Set it before binding to anything but 127.0.0.1.
MILIMO_AUTH_TOKEN=

# Server bind (defaults: 127.0.0.1:8000 — LAN exposure is explicit opt-in)
MILIMO_HOST=127.0.0.1
MILIMO_PORT=8000

# CORS allowlist, comma-separated origins. Empty = localhost dev defaults.
MILIMO_CORS_ORIGINS=

# Requests-per-minute per IP on expensive route groups
# (/agents/, /generate/, /mastering/, /models/download, /transcribe/upload)
MILIMO_RATE_LIMIT_PER_MIN=120

# Upload caps (MB)
MAX_AUDIO_UPLOAD_MB=60
MAX_IMAGE_UPLOAD_MB=8
